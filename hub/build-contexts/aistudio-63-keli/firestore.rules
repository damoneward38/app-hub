rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. GLOBAL SAFETY NET
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── HELPERS ───
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'damoneward38@gmail.com'
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // ─── VALIDATION HELPERS ───

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt']) &&
             data.keys().size() == 3 &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['admin', 'healer', 'observer'] &&
             data.createdAt == request.time;
    }

    function isValidSession(data) {
      return data.keys().hasAll(['userId', 'protocolName', 'startTime', 'duration', 'o2Level', 'frequencies']) &&
             data.keys().size() == 6 &&
             data.userId == request.auth.uid &&
             data.protocolName is string && data.protocolName.size() <= 100 &&
             data.startTime == request.time &&
             data.duration is number && data.duration >= 0 && data.duration <= 86400 &&
             data.o2Level is number && data.o2Level >= 0 && data.o2Level <= 100 &&
             data.frequencies is list && data.frequencies.size() <= 20;
    }

    function isValidProtocol(data) {
      return data.keys().hasAll(['userId', 'name', 'freqs', 'o2', 'duration', 'desc']) &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             data.freqs is list && data.freqs.size() <= 20 &&
             data.o2 is number && data.o2 >= 0 && data.o2 <= 100 &&
             data.duration is number && data.duration >= 0 &&
             data.desc is string && data.desc.size() <= 500;
    }

    // ─── COLLECTION MATCH BLOCKS ───

    // USER PROFILES
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().role == 'observer';
      allow update: if isOwner(userId) && 
                    isValidUser(incoming()) && 
                    incoming().role == existing().role && // Users cannot change their own role
                    incoming().diff(existing()).affectedKeys().hasOnly(['email']);
      allow delete: if isAdmin();
    }

    // HEALING SESSIONS
    match /sessions/{sessionId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(sessionId) && isValidSession(incoming());
      allow update: if false; // Sessions are immutable records
      allow delete: if isAdmin() || (isSignedIn() && isOwner(existing().userId));
    }

    // CUSTOM PROTOCOLS
    match /protocols/{protocolId} {
      allow read: if true; // Public protocols
      allow create: if isEmailVerified() && isValidId(protocolId) && isValidProtocol(incoming());
      allow update: if isEmailVerified() && 
                    isOwner(existing().userId) && 
                    isValidProtocol(incoming()) &&
                    incoming().userId == existing().userId;
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    // ADMIN LIST (Read-only for rules)
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // Managed via console
    }
  }
}
