# PayPal server-side configuration. Copy variable names into the backend secret store.
# Never commit actual credentials or expose them to the client bundle.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MONTHLY_PLAN_ID=
PAYPAL_YEARLY_PLAN_ID=
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=
